# Bu dosyayı .env olarak kopyalayın; .env depoya eklenmez.
SHOPIER_PAT=                 # Shopier panelinden oluşturulan Personal Access Token
APP_URL=https://siteniz.com   # e-postadaki ödeme bağlantıları için
APP_SECRET=                  # en az 16 karakter, rastgele (fatura bağlantılarını imzalar)

# E-posta (SMTP, STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=noreply@siteniz.com
SMTP_PASS=
MAIL_FROM_NAME=Siteniz
MAIL_REPLY_TO=destek@siteniz.com

# İsteğe bağlı
# SHOPIER_WEBHOOK_TOKEN_FILE=/guvenli/yol/webhook.token
# APP_DB=/guvenli/yol/app.sqlite
